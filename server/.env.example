PORT=5000

# Where the frontend is deployed — used for CORS (only this origin, plus
# localhost:5173, is allowed to call the API) and for where OAuth redirects
# send the browser back to after login. Local dev: http://localhost:5173.
# Production: your real Vercel URL, e.g. https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (create a free M0 cluster, get this from Atlas > Connect)
MONGO_URI=

# JWT secret for signing auth tokens (any long random string; generate your own)
JWT_SECRET=

# Google Gemini API key (from Google AI Studio)
GEMINI_API_KEY=

# Optional — pins a specific Gemini model. Defaults to 'gemini-flash-latest' if unset.
GEMINI_MODEL=

# ImageKit credentials (from ImageKit dashboard)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Redis / Upstash (added in Phase 4)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google OAuth (Google Cloud Console > APIs & Services > Credentials > OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# GitHub OAuth (github.com/settings/developers > OAuth Apps > New OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/github/callback
