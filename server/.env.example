PORT=5000

# MongoDB Atlas connection string (create a free M0 cluster, get this from Atlas > Connect)
MONGO_URI=

# JWT secret for signing auth tokens (any long random string; generate your own)
JWT_SECRET=

# Google Gemini API key (from Google AI Studio)
GEMINI_API_KEY=

# ImageKit credentials (from ImageKit dashboard)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Redis / Upstash (added in Phase 4)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
